[gd_resource type="Resource" script_class="NewsEvent" load_steps=14 format=3]

[ext_resource type="Script" path="res://systems/news/news_event.gd" id="1_event"]
[ext_resource type="Script" path="res://systems/news/news_option.gd" id="2_option"]
[ext_resource type="Script" path="res://systems/news/news_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="4_dialogue"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue_line.gd" id="5_line"]
[ext_resource type="Resource" path="res://data/speakers/pescador.tres" id="6_pescador"]

[sub_resource type="Resource" id="Line_01"]
script = ExtResource("5_line")
speaker = ExtResource("6_pescador")
text_key = "NEWS_01_01"

[sub_resource type="Resource" id="Dialogue_news"]
script = ExtResource("4_dialogue")
lines = Array[ExtResource("5_line")]([SubResource("Line_01")])

[sub_resource type="Resource" id="Effect_A_good"]
script = ExtResource("3_effect")
stat = 4
amount = -0.25

[sub_resource type="Resource" id="Effect_A_bad"]
script = ExtResource("3_effect")
stat = 1
amount = 0.2

[sub_resource type="Resource" id="Option_A"]
script = ExtResource("2_option")
title_key = "NEWS_01_A"
effects = Array[ExtResource("3_effect")]([SubResource("Effect_A_good"), SubResource("Effect_A_bad")])

[sub_resource type="Resource" id="Effect_B_good"]
script = ExtResource("3_effect")
stat = 2
amount = 0.25

[sub_resource type="Resource" id="Effect_B_bad"]
script = ExtResource("3_effect")
stat = 6
amount = 0.2

[sub_resource type="Resource" id="Option_B"]
script = ExtResource("2_option")
title_key = "NEWS_01_B"
effects = Array[ExtResource("3_effect")]([SubResource("Effect_B_good"), SubResource("Effect_B_bad")])

[resource]
script = ExtResource("1_event")
dialogue = SubResource("Dialogue_news")
options = Array[ExtResource("2_option")]([SubResource("Option_A"), SubResource("Option_B")])
